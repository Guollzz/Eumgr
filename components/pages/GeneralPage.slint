import { ComboBox } from "std-widgets.slint";

export component GeneralPage inherits Rectangle {
    background: transparent;
    height: 620px;
    width: 975px;

    callback general-page-language-combo-selected(string);

    in-out property<string> language: "language";
    in-out property<string> lang: "zh-CN";
    property <string> view-language: "简体中文";
    property <int> language-num: 1;
    init => {
        if (lang == "zh-CN") {
            view-language = "简体中文"; 
            language-num = 0;
        }
        if (lang == "en") {
            view-language = "English"; 
            language-num = 1;
        }
    }

    Text {
        x: 18px;
        y: 18px;
        text: @tr("{}", language);
        color: black;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 20px;
    }

    ComboBox {
        x: 18px;
        y: 50px;
        // Set the option list for the dropdown box.
        model: ["简体中文", "English"];
        // Set the default selected item.
        current-value: view-language;
        current-index: language-num;

        selected(value) => {
            if value == "简体中文" {
                lang = "zh-CN";
            }
            if value == "English" {
                lang = "en";
            }
            general-page-language-combo-selected(lang);
        }
    }
}