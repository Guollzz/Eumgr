import { ComboBox } from "std-widgets.slint";

export component GeneralPage inherits Rectangle {
    background: transparent;
    height: 620px;
    width: 975px;

    callback general-page-language-combo-selected(string);

    in-out property<string> language: "language";
    in-out property<string> lang: "zh-CN";
    property <string> view-language: "简体中文";
    property <int> language-num: 1;
    init => {
        if (lang == "zh-CN") {
            view-language = "简体中文"; 
            language-num = 0;
        }
        if (lang == "en") {
            view-language = "English"; 
            language-num = 1;
        }
    }

    Text {
        x: 18px;
        y: 18px;
        text: @tr("{}", language);
        color: black;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 20px;
    }

    Rectangle {
        x: 18px;
        y: 50px;
        width: 160px;
        height: 33px;
        background: rgba(0, 0, 0, 0.18);
        border-color: rgba(255, 255, 255, 0.35);
        border-radius: 5px;
        // drop-shadow-blur: 5px;
        // drop-shadow-color: rgba(0, 0, 0, 1); // Use semi-transparent black for a softer effect.
        ComboBox {
            // Set the option list for the dropdown box.
            model: ["简体中文", "English"];
            // Set the default selected item.
            current-value: view-language;
            current-index: language-num;

            selected(value) => {
                if value == "简体中文" {
                    lang = "zh-CN";
                }
                if value == "English" {
                    lang = "en";
                }
                general-page-language-combo-selected(lang);
            }
        }
    }
}