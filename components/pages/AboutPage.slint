export component AboutPage inherits Rectangle {
    background: transparent;
    height: 620px;
    width: 975px;

    in-out property <string> version: "?";

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../assets/icon/icon.png");
                width: 100px;
                height: 100px;
            }
            Text {
                text: @tr("Eumgr {}", version);
                color: black;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 20px;
            }
        }
    }
}