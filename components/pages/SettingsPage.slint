import { ScrollView } from "std-widgets.slint";
import { AboutPage } from "AboutPage.slint";
import { GeneralPage } from "GeneralPage.slint";

export component SettingsPage inherits Rectangle {
    background: transparent;
    height: 630px;
    width: 1190px;

    callback general-page-language(string);

    in-out property<string> general: "general";
    in-out property<string> about: "about";
    in-out property <string> version: "?";
    in-out property<string> language: "language";

    in-out property <int> setting-interface-page: 0;
    
    Rectangle {  // Sidebar.
        x: 5px;
        y: 5px;
        height: 620px;
        width: 200px;
        background: rgba(255, 255, 255, 0.3); 
        border-width:1px;
        border-color: rgba(255, 255, 255, 0.35);
        border-radius: 18px;

        HorizontalLayout {
            alignment: center;
            padding-top: 36px;

            ScrollView {
                height: 584px;
                width: 200px;

                // Define the positions of the three target controls (for easy reuse).
                private property <length> general-button-y: 0px;
                private property <length> about-button-y:50px;

                // State variable: records the current target position to follow.
                in-out property <length> target-y: 0px;

                Rectangle {  // Selected highlight shell.
                    width: 200px;
                    height: 50px;
                    background: rgba(255, 255, 255, 0.3); 
                    border-width:1px;
                    border-color: rgba(255, 255, 255, 0.35);
                    y: target-y;

                    animate y { 
                        duration: 300ms; easing: ease-in-out; 
                    }
                }

                Rectangle {  // General button.
                    y: general-button-y;
                    width: 200px;
                    height: 50px;
                    background: general_button.has-hover?rgba(255, 255, 255, 0.18):rgba(255, 255, 255, 0); 
                    border-width:1px;
                    border-color: general_button.has-hover?rgba(255, 255, 255, 0.35):rgba(255, 255, 255, 0);

                    Text {
                        text: general;
                        color: black;
                        font-size: 20px;
                    }

                    general_button := TouchArea {
                        clicked => {
                            target-y = general-button-y;
                            setting-interface-page = 0;
                        }
                    }
                }

                Rectangle {  // About button
                    y: about-button-y;
                    width: 200px;
                    height: 50px;
                    background: about_button.has-hover?rgba(255, 255, 255, 0.18):rgba(255, 255, 255, 0); 
                    border-width:1px;
                    border-color: about_button.has-hover?rgba(255, 255, 255, 0.35):rgba(255, 255, 255, 0);

                    Text {
                        text: about;
                        color: black;
                        font-size: 20px;
                    }

                    about_button := TouchArea {
                        clicked => {
                            target-y = about-button-y;
                            setting-interface-page = 1;
                        }
                    }
                }
            }
        }
    }

    Rectangle {  // Settings interface.
        x: 210px;
        y: 5px;
        height: 620px;
        width: 975px;
        background: rgba(255, 255, 255, 0.3); 
        border-width:1px;
        border-color: rgba(255, 255, 255, 0.35);
        border-radius: 18px;

        if setting-interface-page == 0 : GeneralPage {
            language: language;

            general-page-language-combo-selected(value) => {
                general-page-language(value)
            }
        }

        if setting-interface-page == 1 : AboutPage {
            version: version;
        }
    }
}