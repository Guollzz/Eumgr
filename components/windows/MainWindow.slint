import { WorkspacePage } from "../pages/WorkspacePage.slint";
import { SettingsPage } from "../pages/SettingsPage.slint";

export global CallbackBridge {
    callback general-page-language-selected(string);
}

export component MainWindow inherits Window {
    title: "Eumgr";
    icon: @image-url("../../assets/icon/icon.png");
    height: 710px;
    width: 1200px;
    background: transparent;  // Transparent background
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 8px;
        clip: true;
        background: grey;
        // Rectangle {  // Use the Image element to host the background image.
        //     width: 100%;
        //     height: 100%;
        //     clip: true;
        //     Image {
        //         source: @image-url("../../assets/icon/icon.png");
        //         image-fit: cover;
        //         width: 100%;
        //         height: 100%;
        //     }
        // }
    }

    no-frame: true;

    // Declare close window callback and minimize callback to complete corresponding operations.
    callback close_requested;
    callback minimize_requested;

    property <bool> is-dragging: false;
    property <length> drag-start-x: 0px;
    property <length> drag-start-y: 0px;
    callback move-window(float, float);

    in-out property<string> dynamic-island-text: "dynamic-island-text";
    in-out property<string> workspace: "workspace";
    in-out property<string> settings: "settings";
    in-out property <string> general: "general";
    in-out property <string> about: "about";
    in-out property <string> version: "?";
    in-out property<string> language: "language";

    in-out property <int> operation-area-page: 0;

    VerticalLayout {  // Title bar area detection.
        Rectangle {  // Handle window dragging.
            height: 35px;
            
            touch-area := TouchArea {
                width: 100%;
                height: 100%;
                
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.is-dragging = true;
                        root.drag-start-x = self.mouse-x;
                        root.drag-start-y = self.mouse-y;
                    } else if (event.kind == PointerEventKind.up) {
                        root.is-dragging = false;
                    }
                }
                
                moved => {
                    if (root.is-dragging) {
                        root.move-window(
                            (self.mouse-x - root.drag-start-x) / 1px,
                            (self.mouse-y - root.drag-start-y) / 1px
                        );
                    }
                }
            }
        }
    }

    Text {
        x: 15px;
        y: 5px;
        text: "Eumgr";
        color: black;
        font-size: 25px;
        //font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    } 

    Rectangle {  // 1px White stroke
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #ffffff;  
        border-radius: 8px;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: rgba(255, 255, 255, 0.18); 
        border-width:1px;
        border-color:rgba(255,255,255,0.35);
        border-radius: 8px;
    }

    Rectangle {  // Title bar divider line
        y: 35px;
        width: 1175px;
        height: 1px;
        background: rgba(0, 0, 0, 0.2);  
    }

    Rectangle {  //Close button
        x: parent.width - 5px - 30px;
        y: 5px;                      
        width: 25px;
        height: 25px;
        border-radius: 12.5px;          
        background: close_button.has-hover?rgba(255, 255, 255, 0.5):rgba(255, 255, 255, 0.18); 
        transform-rotation: 45deg;
        border-width:1px;
        border-color:rgba(255,255,255,0.35);

        Text {
            text: "+";
            color: black;
            font-size: 30px;
            //font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        // Click interaction.
        close_button := TouchArea {
            clicked => {
                close_requested();
            }
        }
    }

    Rectangle {  //Minimize button.
        x: parent.width - 5px - 30px - 30px;
        y: 5px;                      
        width: 25px;
        height: 25px;
        border-radius: 12.5px;          
        background: minimize_button.has-hover?rgba(255, 255, 255, 0.5):rgba(255, 255, 255, 0.18); 
        border-width:1px;
        border-color:rgba(255,255,255,0.35);
        Text {
            y: -1px;
            text: "—";
            color: black;
            font-size: 17px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        // Click interaction.
        minimize_button := TouchArea {
            clicked => {
                minimize_requested();
            }
        }
    }

    Rectangle {  // Switch page.
        HorizontalLayout {
            //x: 100px;
            alignment: center;
            padding-top: 5px;

            Rectangle {
                width: 75px + 5px + 75px;
                height: 25px;

                background: rgba(255, 255, 255, 0.18); 
                border-width:1px;
                border-color:rgba(255,255,255,0.35);

                border-radius: 12.5px;

                // Define the positions of the three target controls (for easy reuse).
                private property <length> workspace-button-x: 0px;
                private property <length> settings-button-x: 5px + 75px;

                // State variable: records the current target position to follow.
                in-out property <length> target-x: 0px;

                Rectangle {  // Selected highlight shell.
                    width: 75px;
                    height: 25px;
                    background: rgba(255, 255, 255, 0.3); 
                    border-width:1px;
                    border-color: rgba(255, 255, 255, 0.35);
                    border-radius: 12.5px;
                    x: target-x;

                    animate x { 
                        duration: 300ms; easing: ease-in-out; 
                    }
                }

                Rectangle {  // Workspace button.
                    x: workspace-button-x;

                    width: 75px;
                    height: 25px;

                    Text {
                        width: parent.width;
                        height: parent.height;

                        text: workspace;
                        color: black;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    background: workspace_button.has-hover?rgba(255, 255, 255, 0.18):rgba(255, 255, 255, 0); 
                    border-width:1px;
                    border-color:workspace_button.has-hover?rgba(255, 255, 255, 0.35):rgba(255, 255, 255, 0);

                    border-radius: 12.5px;

                    workspace_button := TouchArea{
                        clicked => {
                            target-x = workspace-button-x;
                            operation-area-page = 0;
                        }
                    }
                }   

                Rectangle {  // Settings button.
                    x: settings-button-x;
                    
                    width: 75px;
                    height: 25px;

                    background: settings_button.has-hover?rgba(255, 255, 255, 0.18):rgba(255, 255, 255, 0); 
                    border-width:1px;
                    border-color:  settings_button.has-hover?rgba(255, 255, 255, 0.35):rgba(255, 255, 255, 0);

                    border-radius: 12.5px;

                    Text {
                        width: parent.width;
                        height: parent.height;

                        text: settings;
                        color: black;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    settings_button := TouchArea {
                        clicked => {
                            target-x = settings-button-x;
                            operation-area-page = 1;
                        }
                    }
                }
            }   
        }
    }

    Rectangle {  // Dynamic Island.
        HorizontalLayout {
            alignment: center;
            padding-top: 40px;

            Text {
                height: 30px;
                text: dynamic-island-text;
                color: black;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;

                Rectangle {
                    width: parent.width + 10px;
                    height: parent.height;
                    background: rgba(255, 255, 255, 0.3); 
                    border-width:1px;
                    border-color: rgba(255, 255, 255, 0.35);
                    border-radius: 15px;
                }
            }
        }
    }

    Rectangle {  // Operation area.
        HorizontalLayout {
            alignment: center;
            padding-top: 35px;
            width: 1190px;
            height: 630px;

            Rectangle {
                width: parent.width;
                height: parent.height;
                background: rgba(255, 255, 255, 0.3); 
                border-width:1px;
                border-color: rgba(255, 255, 255, 0.35);
                border-radius: 23px;

                if operation-area-page == 0 : WorkspacePage {

                }
                if operation-area-page == 1 : SettingsPage {
                    general: general;
                    about: about;
                    version: version;
                    language: language;

                    general-page-language(value) => {
                        CallbackBridge.general-page-language-selected(value);
                    }
                }
            }
        }
    }
}